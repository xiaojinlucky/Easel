# Dependencies
node_modules/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/

# Environment
.env
.env.local
.env.xhs

# Docker
docker/data/

# IDE
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# OpenClaw runtime
.openclaw/

# Local runtime state: research.sqlite（全量采集内容）、clipper-pairing token、宿主日志，禁止入库
.runtime/

# Outputs (keep directory structure via .gitkeep, ignore actual content)
outputs/**/*
!outputs/**/.gitkeep

# Assets (user materials are not tracked; curated brand/README media is)
assets/**/*
!assets/**/.gitkeep
!assets/icon.png
!assets/icon-transparent.png
!assets/icon-noword.png
!assets/readme/
!assets/readme/**

# Session files
*.jsonl

# Logs
*.log
logs/

# Build artifacts
*.egg-info/
.last-session
.pytest_cache/

# 登录态 / 凭证（绝不入库——含 SESSDATA 等 token）
cookies.json

# Local account profiles (publish only the reusable template)
profiles/*/
!profiles/_template/
!profiles/_template/**

# 临时 / scratch（ad-hoc 运行残留）
.scratch/
.drama_run/
.drama_tmp/
.claude/

# SKILL 自研原始版本（保留备查，含嵌套 git 仓库，不入库）
skill-test/

# 备份/临时文件
*.bak
*.orig
*.tmp
*.swp

# 公众号发布器用户凭证配置（含 AppID/AppSecret），只提交 .example 模板
skills/openclaw/skill-wechat-publisher/wechat-publisher.yaml

# 素材库导出的知识库目录（Beav 式布局，本机产物）
knowledge/

# 本机 Python 虚拟环境（现役树装在 .venv/，2 万多个文件，绝不能进 git status）
.venv/
