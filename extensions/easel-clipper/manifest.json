{
  "manifest_version": 3,
  "name": "Easel 素材采集",
  "version": "1.0.0",
  "description": "点击保存当前网页正文或选中文字到你的本地 Easel 素材库。正文提取复用 Mozilla Readability。",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:7860/*"],
  "action": { "default_title": "保存到 Easel", "default_popup": "popup.html" }
}
