{
  "manifest_version": 3,
  "name": "Beav采集 → Easel（个人非商用）",
  "description": "将网页、链接、选中文字、图片、视频和评论保存到本机 Easel 素材库（个人非商用）。",
  "version": "2.7.18.65535",
  "version_name": "2.7.18",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "alarms",
    "contextMenus",
    "clipboardWrite",
    "downloads",
    "nativeMessaging",
    "notifications",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.xiaohongshu.com/*",
    "https://www.rednote.com/*",
    "https://edith.xiaohongshu.com/*",
    "https://pgy.xiaohongshu.com/*",
    "https://www.douyin.com/*",
    "https://www.kuaishou.com/*",
    "https://live.kuaishou.com/*",
    "https://www.tiktok.com/*",
    "https://www.bilibili.com/*",
    "https://space.bilibili.com/*",
    "https://search.bilibili.com/*",
    "https://b23.tv/*",
    "https://mp.weixin.qq.com/*",
    "https://zhihu.com/*",
    "https://www.zhihu.com/*",
    "https://zhuanlan.zhihu.com/*",
    "https://*.xhscdn.com/*",
    "https://*.rednotecdn.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.xiaohongshu.com/*",
        "https://www.rednote.com/*"
      ],
      "js": ["vendor/md5.min.js", "xhsBridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.xiaohongshu.com/*",
        "https://www.rednote.com/*",
        "https://mp.weixin.qq.com/*",
        "https://www.zhihu.com/*",
        "https://zhuanlan.zhihu.com/*",
        "https://www.douyin.com/*",
        "https://www.bilibili.com/*"
      ],
      "js": ["pageObserver.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pageRouteBridge.js", "images/cursor-chat.png"],
      "matches": ["https://www.xiaohongshu.com/*", "https://www.rednote.com/*"]
    }
  ],
  "commands": {
    "open-redbox-side-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open Easel capture side panel"
    },
    "open-codex-side-panel": {
      "description": "Open Codex-compatible browser control side panel"
    }
  },
  "action": {
    "default_title": "Easel 采集",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "settings.html",
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}

